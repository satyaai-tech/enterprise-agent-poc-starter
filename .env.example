# POC-only identity continuity diagnostics. Never enable in production.
POC_LOG_RAW_USER_ID=false
BANKING_TEST_USER_OID=
# Slice 5C account ownership map. Use Entra object IDs only in local .env, never here.
# Example shape: {"acct-9000":"<reader-oid>","acct-9001":"<reader-oid>","acct-1001":"<writer-oid>","acct-2002":"<writer-oid>","acct-3003":"<writer-oid>"}
BANKING_ACCOUNT_OWNERS_JSON=

# Banking MCP protected API
ENTRA_BANKING_CLIENT_ID=
ENTRA_BANKING_APPLICATION_ID_URI=
ENTRA_BANKING_SCOPE=
# Space- or comma-separated full delegated scope URIs; Slice 5C requires Banking.Read and Banking.Write.
ENTRA_BANKING_SCOPES=
ENTRA_BANKING_EXPECTED_AUDIENCE=

# Phase 4: local Google ADK Agent A with Ollama
OLLAMA_MODEL=qwen3:8b
OLLAMA_API_BASE=http://localhost:11434
